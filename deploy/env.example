# Copiar a /srv/santos-nhf/.env en el servidor y completar. Este archivo NO va
# al repo: son los secretos de producción.
#
#   install -m 600 env.example /srv/santos-nhf/.env
#
# Cada variable sin valor por defecto corta el `docker compose up` con un error
# que la nombra, así que no hay forma de levantar el stack a medio configurar.

# Imagen publicada por GitHub Actions. El workflow la reescribe en cada deploy.
SERVER_IMAGE=ghcr.io/goncastrop/santos-nhf-server:latest

# Base de datos. Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=

# Secreto de servicio de Serverpod (Insights). Generar igual que el anterior.
SERVICE_SECRET=

# Claves de autenticación. COPIAR LOS VALORES QUE YA USA SERVERPOD CLOUD.
# Si se generan nuevas, las contraseñas existentes dejan de validar, los refresh
# tokens se invalidan y los access tokens emitidos dejan de verificar: todos los
# usuarios tienen que hacer "olvidé mi contraseña".
EMAIL_SECRET_HASH_PEPPER=
JWT_REFRESH_TOKEN_HASH_PEPPER=
JWT_HMAC_SHA512_PRIVATE_KEY=

# Emails que pueden pedir el rol admin, separados por comas.
ADMIN_EMAILS=

# SMTP de Brevo (Settings > SMTP & API). El usuario es el que muestra el panel,
# la clave es una SMTP key, no la contraseña de la cuenta.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-responder@nhf.com.ar

# Mail al que Let's Encrypt avisa si un certificado está por vencer sin renovar.
ACME_EMAIL=

# Ingreso con Google. El JSON del cliente OAuth web de Google Cloud Console, en una
# sola línea y entre comillas simples. Tiene que traer "redirect_uris" con
# https://santos.nhf.com.ar/auth/callback. Vacío deja el ingreso con Google apagado.
GOOGLE_CLIENT_SECRET_JSON=
